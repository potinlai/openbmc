#!/bin/bash

readonly EXT_SNR_SERVICE="xyz.openbmc_project.ExternalSensor"
readonly SNR_VAL_INTF="xyz.openbmc_project.Sensor.Value"

is_host_on() {
    local state
    state=$(busctl get-property \
            xyz.openbmc_project.State.Host \
            /xyz/openbmc_project/state/host0 \
            xyz.openbmc_project.State.Host CurrentHostState \
        | cut -d'"' -f2)

    [[ "$state" == "xyz.openbmc_project.State.Host.HostState.Running" ]]
}

get_numeric_sensor_by_eid() {
    local eid="$1"
    local snr_id="$2"

    local out
    out=$(pldmtool platform GetSensorReading -i "$snr_id" -r 0 -m "$eid") || return 1

    jq -e '.presentReading' <<< "$out" 2>/dev/null
}

update_numeric_sensor_value() {
    local eid="$1"
    local snr_id="$2"
    local snr_name="$3"

    local val
    if ! val=$(get_numeric_sensor_by_eid "$eid" "$snr_id"); then
        echo "sensor read failed: eid=$eid id=$snr_id name=$snr_name"
        return 1
    fi

    local path=""
    case "$snr_name" in
        *_TEMP_C) path="/xyz/openbmc_project/sensors/temperature/$snr_name" ;;
        *_PWR_W)  path="/xyz/openbmc_project/sensors/power/$snr_name" ;;
        *) return 0 ;;
    esac

    busctl set-property "$EXT_SNR_SERVICE" "$path" "$SNR_VAL_INTF" Value d "$val"
}

poll_numeric_sensor() {
    local eid="$1"
    local snr_id="$2"
    local snr_name="$3"

    if ! is_host_on; then
        echo "host off, skip sensor polling"
        return 1
    fi

    update_numeric_sensor_value "$eid" "$snr_id" "$snr_name"
    return 0
}

set_external_sensor_invalid() {
    local name="$1"
    local path=""

    case "$name" in
        *_TEMP_C) path="/xyz/openbmc_project/sensors/temperature/$name" ;;
        *_PWR_W)  path="/xyz/openbmc_project/sensors/power/$name" ;;
        *) echo "skip invalid set (unknown type): $name"; return ;;
    esac

    busctl set-property "$EXT_SNR_SERVICE" "$path" "$SNR_VAL_INTF" Value d nan
}

set_all_external_sensors_invalid() {
    local nic="$1"

    set_external_sensor_invalid "${nic}_OSFP_TEMP_C"
    set_external_sensor_invalid "${nic}_TEMP_C"
    set_external_sensor_invalid "${nic}_PWR_W"
}

execute_when_host_off() {
    local nic="$1"
    echo "host off, invalidate sensors ($nic)"
    set_all_external_sensors_invalid "$nic"
}

fetch_pdr() {
    local eid="$1"
    local file="/tmp/pldm_pdr_${eid}.json"

    pldmtool platform GetPDR -m "$eid" -a > "$file"
    echo "$file"
}

build_sensor_list() {
    local file="$1"
    local -n out=$2

    out=()

    for id in "${CHECK_IDS[@]}"; do
        if jq -e --argjson sid "$id" \
            'any(.[]; .PDRType=="Numeric Sensor PDR" and .sensorID==$sid)' \
            "$file" > /dev/null; then
            out+=("$id")
        fi
    done
}

handle_host_transition() {
    local current="$1"
    local nic="$2"

    if [[ "$current" != "$LAST_HOST_READY" ]]; then
        if [[ "$current" == "1" ]]; then
            echo "host ON, wait stabilization"
            sleep 10
        else
            echo "host Off, set sensors to nan"
            execute_when_host_off "$nic"
            SNR_AVAIL_LIST=()   # clear list when host off
        fi
    fi

    LAST_HOST_READY="$current"
}

poll_sensors() {
    local eid="$1"
    local nic_name="$2"
    shift 2
    local sensors=("$@")

    for snr_id in "${sensors[@]}"; do
        local suffix="${SENSOR_NAME_MAP[$snr_id]}"
        local label="${nic_name}_${suffix}"

        poll_numeric_sensor "$eid" "$snr_id" "$label"
    done
}

# -----------------------------
# Main
# -----------------------------
declare -A NIC_EID_MAP=(
    [IOB0_NIC0]=32 [IOB0_NIC1]=34
    [IOB1_NIC0]=42 [IOB1_NIC1]=44
    [IOB2_NIC0]=52 [IOB2_NIC1]=54
    [IOB3_NIC0]=62 [IOB3_NIC1]=64
    [NS_NIC]=72
)

declare -A SENSOR_NAME_MAP=(
    [500]="OSFP_TEMP_C"
    [300]="TEMP_C"
    [50]="PWR_W"
)

CHECK_IDS=(50 300 500)

LAST_HOST_READY="0"
NIC_NAME="${1:-}"

if [[ -z "$NIC_NAME" ]]; then
    echo "missing NIC_NAME"
    exit 1
fi

if [[ -z "${NIC_EID_MAP[$NIC_NAME]:-}" ]]; then
    echo "invalid NIC_NAME: $NIC_NAME"
    exit 1
fi

NIC_EID="${NIC_EID_MAP[$NIC_NAME]}"
echo "NIC_NAME: $NIC_NAME"
echo "NIC_EID: $NIC_EID"

while true; do
    sleep 2

    HOST_READY=$(is_host_on && echo "1" || echo "0")

    handle_host_transition "$HOST_READY" "$NIC_NAME"

    [[ "$HOST_READY" != "1" ]] && continue

    if [[ ${#SNR_AVAIL_LIST[@]} -eq 0 ]]; then
        echo "no available sensors for $NIC_NAME"
        echo "fetch PDR & build sensor list"
        PDR_FILE=$(fetch_pdr "$NIC_EID")
        build_sensor_list "$PDR_FILE" SNR_AVAIL_LIST
        echo "available sensors: ${SNR_AVAIL_LIST[*]:-(none)}"
    fi

    poll_sensors "$NIC_EID" "$NIC_NAME" "${SNR_AVAIL_LIST[@]}"

done
